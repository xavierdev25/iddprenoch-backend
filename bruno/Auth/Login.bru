meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombre": "{{process.env.BRUNO_USUARIO}}",
    "password": "{{process.env.BRUNO_PASSWORD}}"
  }
}

tests {
  test("login exitoso devuelve 200", function () {
    expect(res.status).to.equal(200);
  });

  test("devuelve el usuario sin el hash de password", function () {
    expect(res.body).to.have.property("nombre", bru.getProcessEnv("BRUNO_USUARIO"));
    expect(res.body).to.not.have.property("passwordHash");
  });
}
