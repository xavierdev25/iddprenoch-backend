# Credenciales para la colección Bruno. Copiar a bruno/.env (ignorado por git) y completar.
# Bruno las lee como {{process.env.NOMBRE}}. Nunca escribir contraseñas en los .bru: el repo es público.
BRUNO_USUARIO=
BRUNO_PASSWORD=
# Contraseña (mín. 8 caracteres) con la que "Usuarios/Crear" da de alta un usuario de prueba.
BRUNO_PASSWORD_USUARIO_PRUEBA=
