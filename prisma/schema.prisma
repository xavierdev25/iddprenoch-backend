generator client {
  provider      = "prisma-client-js"
  // rhel-openssl-3.0.x es el motor que usa el hosting (CloudLinux, familia RHEL): verificado el
  // 21/11/2026 en el cliente que el servidor carga. debian-openssl-1.1.x se conserva por compatibilidad.
  binaryTargets = ["native", "debian-openssl-1.1.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Distrito {
  id        Int        @id @default(autoincrement())
  nombre    String     @unique
  iglesias  Iglesia[]
  usuarios  Usuario[]
  asambleas Asamblea[]

  @@map("distritos")
}

model Iglesia {
  id           Int           @id @default(autoincrement())
  nombre       String
  direccion    String        @db.Text
  foto         String?       @db.LongText
  // Coordenadas del punto exacto de la sede. Se guardan como Float (DOUBLE en MySQL) en vez de
  // Decimal porque son mediciones, no importes: no requieren aritmética decimal exacta y evitan
  // el wrapper Prisma.Decimal al serializar a JSON. La mayoría de las sedes no figura como lugar
  // en Google Maps, así que el dato viene de soltar un pin, no de buscar el nombre.
  latitud      Float?
  longitud     Float?
  distrito     Distrito      @relation(fields: [distritoId], references: [id])
  distritoId   Int           @map("distrito_id")
  ministerio   Ministerio?   @relation(fields: [ministerioId], references: [id])
  ministerioId Int?          @map("ministerio_id")
  pastores     Pastor[]
  lideres      Lider[]
  congregantes Congregante[]
  electores    Elector[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([distritoId])
  @@index([ministerioId])
  @@map("iglesias")
}

model Cargo {
  id       Int      @id @default(autoincrement())
  nombre   String   @unique
  pastores Pastor[]

  @@map("cargos")
}

model Pastor {
  id           Int      @id @default(autoincrement())
  nombrePastor String   @map("nombre_pastor")
  celular      String?
  foto         String?  @db.LongText
  iglesia      Iglesia  @relation(fields: [iglesiaId], references: [id])
  iglesiaId    Int      @map("iglesia_id")
  cargo        Cargo    @relation(fields: [cargoId], references: [id])
  cargoId      Int      @map("cargo_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([iglesiaId])
  @@index([cargoId])
  @@map("pastores")
}

model Ministerio {
  id           Int           @id @default(autoincrement())
  nombre       String        @unique
  slug         String?       @unique
  descripcion  String?       @db.Text
  iglesias     Iglesia[]
  lideres      Lider[]
  congregantes Congregante[]

  @@map("ministerios")
}

model Lider {
  id           Int        @id @default(autoincrement())
  dni          String     @unique @db.Char(8)
  nombre       String
  apellido     String
  telefono     String?
  correo       String?
  ministerio   Ministerio @relation(fields: [ministerioId], references: [id])
  ministerioId Int        @map("ministerio_id")
  iglesia      Iglesia    @relation(fields: [iglesiaId], references: [id])
  iglesiaId    Int        @map("iglesia_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@index([ministerioId])
  @@index([iglesiaId])
  @@map("lideres")
}

model Congregante {
  id               Int            @id @default(autoincrement())
  dni              String         @unique @db.Char(8)
  nombre           String
  apellido         String
  telefono         String?
  correo           String?
  foto             String?        @db.LongText
  // El grupo etario (niño/adolescente/joven/adulto) NO se guarda: se deriva de esta fecha en cada
  // consulta (ver utils/edad.ts). Guardarlo se desincronizaría en silencio cada cumpleaños, y los
  // reportes de membresía se leen justamente para saber la composición actual.
  fechaNacimiento  DateTime?      @map("fecha_nacimiento") @db.Date
  iglesia          Iglesia        @relation(fields: [iglesiaId], references: [id])
  iglesiaId        Int            @map("iglesia_id")
  // Ministerio en el que participa. Opcional: no todo congregante sirve en un ministerio.
  ministerio       Ministerio?    @relation(fields: [ministerioId], references: [id])
  ministerioId     Int?           @map("ministerio_id")
  sexo             Sexo           @relation(fields: [sexoId], references: [id])
  sexoId           Int            @map("sexo_id")
  estadoCivil      EstadoCivil    @relation(fields: [estadoCivilId], references: [id])
  estadoCivilId    Int            @map("estado_civil_id")
  estadoEclesial   EstadoEclesial @relation(fields: [estadoEclesialId], references: [id])
  estadoEclesialId Int            @map("estado_eclesial_id")
  fechaConversion  DateTime?      @map("fecha_conversion") @db.Date
  fechaBautismo    DateTime?      @map("fecha_bautismo") @db.Date
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@index([iglesiaId])
  @@index([ministerioId])
  @@index([sexoId])
  @@index([estadoCivilId])
  @@index([estadoEclesialId])
  // Los reportes filtran por rango de fecha de nacimiento para acotar grupos etarios en SQL.
  @@index([fechaNacimiento])
  @@map("congregantes")
}

model Evento {
  id           Int      @id @default(autoincrement())
  nombre       String
  fechaConHora DateTime @map("fecha_con_hora")
  ubicacion    String?  @db.Text
  imagen       String?  @db.LongText
  descripcion  String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([fechaConHora])
  @@map("eventos")
}

model Comunicado {
  id          Int      @id @default(autoincrement())
  titulo      String
  imagen      String?  @db.LongText
  descripcion String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("comunicados")
}

model Rol {
  id       Int       @id @default(autoincrement())
  nombre   String    @unique
  usuarios Usuario[]

  @@map("roles")
}

model EstadoUsuario {
  id       Int       @id @default(autoincrement())
  nombre   String    @unique
  usuarios Usuario[]

  @@map("estados_usuario")
}

model Usuario {
  id           Int           @id @default(autoincrement())
  nombre       String        @unique
  email        String?       @unique
  passwordHash String        @map("password_hash")
  rol          Rol           @relation(fields: [rolId], references: [id])
  rolId        Int           @map("rol_id")
  estado       EstadoUsuario @relation(fields: [estadoId], references: [id])
  estadoId     Int           @map("estado_id")
  // Alcance territorial. Null para los roles de alcance regional; obligatorio para el obispo
  // distrital (lo valida usuarios.service, no la base: depende del nombre del rol). Restrict y no
  // el SetNull por defecto: borrar el distrito dejaría a su obispo sin alcance definido.
  distrito     Distrito?     @relation(fields: [distritoId], references: [id], onDelete: Restrict)
  distritoId   Int?          @map("distrito_id")
  auditoria    Auditoria[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([rolId])
  @@index([estadoId])
  @@index([distritoId])
  @@map("usuarios")
}

enum ResultadoAuditoria {
  PERMITIDO
  DENEGADO
}

// Registro de logins, cambios de membresía y de usuarios, y accesos denegados. Se conserva 12
// meses (Ley 29733, ver ADR-027): utils/auditoria.ts borra a diario lo más antiguo.
model Auditoria {
  id            Int                @id @default(autoincrement())
  // SetNull: borrar un usuario no debe borrar el rastro de lo que hizo.
  usuario       Usuario?           @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  usuarioId     Int?               @map("usuario_id")
  // Copia del nombre al momento del evento: identifica un login fallido (sin usuario) y sobrevive
  // al borrado o renombre de la cuenta.
  usuarioNombre String?            @map("usuario_nombre") @db.VarChar(255)
  accion        String             @db.VarChar(40)
  recurso       String             @db.VarChar(255)
  resultado     ResultadoAuditoria
  // Qué cambió, en texto: nombres de campos, nunca sus valores personales (DNI, teléfono...).
  detalle       String?            @db.Text
  ip            String?            @db.VarChar(45)
  fecha         DateTime           @default(now())

  @@index([fecha])
  @@index([usuarioId])
  @@index([resultado])
  @@map("auditoria")
}

model Sexo {
  id           Int           @id @default(autoincrement())
  nombre       String        @unique
  congregantes Congregante[]

  @@map("sexo")
}

model EstadoCivil {
  id           Int           @id @default(autoincrement())
  nombre       String        @unique
  congregantes Congregante[]

  @@map("estado_civil")
}

model EstadoEclesial {
  id           Int           @id @default(autoincrement())
  nombre       String        @unique
  congregantes Congregante[]

  @@map("estado_eclesial")
}

// ─── Votación electrónica en asambleas presenciales (ADR-029) ──────────────────────────────────

enum TipoAsamblea {
  REGIONAL
  DISTRITAL
}

enum EstadoAsamblea {
  PROGRAMADA
  EN_CURSO
  FINALIZADA
}

enum EstadoEleccion {
  PENDIENTE
  ABIERTA
  CERRADA
}

model Asamblea {
  id           Int            @id @default(autoincrement())
  nombre       String
  tipo         TipoAsamblea
  // Solo las DISTRITALES tienen distrito: es lo que acota al obispo distrital (ADR-026).
  distrito     Distrito?      @relation(fields: [distritoId], references: [id], onDelete: Restrict)
  distritoId   Int?           @map("distrito_id")
  fecha        DateTime
  // Va en el QR y en la URL /votar/:codigo. Aleatorio y sin caracteres ambiguos (0/O, 1/I).
  codigoAcceso String         @unique @map("codigo_acceso") @db.VarChar(12)
  estado       EstadoAsamblea @default(PROGRAMADA)
  elecciones   Eleccion[]
  electores    Elector[]
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@index([distritoId])
  @@map("asambleas")
}

// No reutiliza el modelo Cargo (cargos pastorales): el cargo de una elección es texto libre.
model Eleccion {
  id          Int            @id @default(autoincrement())
  asamblea    Asamblea       @relation(fields: [asambleaId], references: [id], onDelete: Cascade)
  asambleaId  Int            @map("asamblea_id")
  cargo       String
  ronda       Int            @default(1)
  estado      EstadoEleccion @default(PENDIENTE)
  // Métricas para el informe (CSV sin datos personales): apertura, cierre y publicación.
  abiertaEn   DateTime?      @map("abierta_en")
  cerradaEn   DateTime?      @map("cerrada_en")
  publicadaEn DateTime?      @map("publicada_en")
  ganador     Candidato?     @relation("GanadorEleccion", fields: [ganadorId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  ganadorId   Int?           @unique @map("ganador_id")
  candidatos  Candidato[]    @relation("CandidatosEleccion")
  emisiones   Emision[]
  votos       Voto[]
  createdAt   DateTime       @default(now()) @map("created_at")

  // La segunda vuelta es otra fila con el mismo cargo y ronda + 1.
  @@unique([asambleaId, cargo, ronda])
  @@map("elecciones")
}

model Candidato {
  id         Int       @id @default(autoincrement())
  eleccion   Eleccion  @relation("CandidatosEleccion", fields: [eleccionId], references: [id], onDelete: Cascade)
  eleccionId Int       @map("eleccion_id")
  nombre     String
  // Línea secundaria de la cédula, p. ej. "Distrito Huaura" (prototipo, Figura 16).
  detalle    String?
  // Mismo patrón que el resto del repo: data URL base64. El panel la reduce antes de subirla.
  foto       String?   @db.LongText
  orden      Int       @default(0)
  ganoEn     Eleccion? @relation("GanadorEleccion")
  votos      Voto[]

  @@index([eleccionId])
  @@map("candidatos")
}

// Padrón de la asamblea. Acreditar = generar el código de 4 dígitos y entregarlo en la mesa.
model Elector {
  id           Int       @id @default(autoincrement())
  asamblea     Asamblea  @relation(fields: [asambleaId], references: [id], onDelete: Cascade)
  asambleaId   Int       @map("asamblea_id")
  dni          String    @db.Char(8)
  nombre       String
  iglesia      Iglesia?  @relation(fields: [iglesiaId], references: [id], onDelete: SetNull)
  iglesiaId    Int?      @map("iglesia_id")
  // bcrypt del código de 4 dígitos; el código en claro se muestra una sola vez y no se guarda.
  codigoHash   String?   @map("codigo_hash")
  acreditado   Boolean   @default(false)
  acreditadoEn DateTime? @map("acreditado_en")
  emisiones    Emision[]

  @@unique([asambleaId, dni])
  @@index([iglesiaId])
  @@map("electores")
}

// Quién votó en qué elección (sin el sentido del voto). El @@unique impide el doble voto.
model Emision {
  id         Int      @id @default(autoincrement())
  eleccion   Eleccion @relation(fields: [eleccionId], references: [id], onDelete: Cascade)
  eleccionId Int      @map("eleccion_id")
  elector    Elector  @relation(fields: [electorId], references: [id], onDelete: Cascade)
  electorId  Int      @map("elector_id")
  emitidoEn  DateTime @default(now()) @map("emitido_en")

  @@unique([eleccionId, electorId])
  @@index([electorId])
  @@map("emisiones")
}

// El voto: SIN fecha y SIN referencia al elector, con id UUID aleatorio (no secuencial). Así no
// hay columna ni orden de inserción que permita unir un voto con su emisión: voto secreto.
model Voto {
  id          String    @id @default(uuid()) @db.Char(36)
  eleccion    Eleccion  @relation(fields: [eleccionId], references: [id], onDelete: Cascade)
  eleccionId  Int       @map("eleccion_id")
  candidato   Candidato @relation(fields: [candidatoId], references: [id], onDelete: Cascade)
  candidatoId Int       @map("candidato_id")

  @@index([eleccionId])
  @@index([candidatoId])
  @@map("votos")
}
