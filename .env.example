# Clave del MySQL local de docker-compose.dev.yml (puerto 3307). Elegir una y repetirla abajo.
DEV_MYSQL_ROOT_PASSWORD=
# Base de desarrollo.
DATABASE_URL="mysql://root:<DEV_MYSQL_ROOT_PASSWORD>@localhost:3307/iglesia_dev"
# Servidor para `npm run test:integration`: cada corrida crea una base con este nombre más un sufijo
# único y la borra al terminar. El nombre debe contener "test".
TEST_DATABASE_URL="mysql://root:<DEV_MYSQL_ROOT_PASSWORD>@localhost:3307/iglesia_test"
# Clave de los usuarios que crea el seed (solo desarrollo). Sin ella, el seed genera una al azar.
SEED_PASSWORD=
JWT_SECRET="replace-with-a-long-random-string"
PORT=3000
NODE_ENV=development
COOKIE_SECURE=false
# Spike de tiempo real (ADR-028): solo si se quiere probar en local. Mínimo 16 caracteres.
# SPIKE_TOKEN=
