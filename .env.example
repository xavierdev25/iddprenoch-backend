# Base de desarrollo: la del docker-compose.dev.yml (puerto 3307).
DATABASE_URL="mysql://root:iddp_dev@localhost:3307/iglesia_dev"
# Base para `npm run test:integration`: se BORRA y se recrea en cada corrida. Nunca apuntarla a
# una base con datos reales.
